<?xml version="1.0" encoding="UTF-8"?>
<!-- ======================================================= -->
<!-- ========== Template Management Notes ========== -->
<!--
    This XML document modifies and overrides templates from MIR.
    Templates are organized in dedicated sections below:
        1. New
        2. Overrides
        3. Modifications
    Sections are provided for Admin, Host, Genre, and general templates including helper templates.
    Empty sections are avoided to reduce confusion.
    Templates within each section should be sorted alphabetically.
    General new templates should NOT be defined here; they must be placed in a *-editor-includes file.
    Circular references must be avoided to prevent loops or unintended overrides.
-->
<!-- ======================================================= -->
<xed:template xmlns:xed="http://www.mycore.de/xeditor" xmlns:mir="http://www.mycore.de/mir">

  <!-- ========== Admin: Modifications ========== -->
  <xed:modify ref="admin.fields">
    <xed:remove ref="related.item.other.search.of.all.items" />
  </xed:modify>

  <!-- ========== Host: Overrides ========== -->
  <!-- adds year, volume and issue of the host -->
  <xed:template id="hosts.issue">
    <div class="mir-form-group-body">
      <xed:bind xpath="mods:relatedItem[@type='host']">
        <xed:bind
          xpath="@xlink:href"
          initially="{$MIR.projectid.default}_mods_00000000">
          <input id="relItem-issue" type="hidden" />
        </xed:bind>
        <xed:include ref="title.issue.relItemsearch" />
        <xed:include ref="identifier.issn.issue.relItemsearch" />
      </xed:bind>
      <xed:include ref="year.issued.relItem" />
      <xed:bind xpath="mods:relatedItem[@type='host']">
        <xed:include ref="host.volume" />
        <xed:include ref="host.issue" />
        <xed:include ref="host.pages" />
      </xed:bind>
    </div>
  </xed:template>

  <!-- ========== Genre: Overrides ========== -->
  <xed:template id="genres.issue">
    <xed:include ref="title.original" />
    <xed:include ref="author.repeated" />
    <xed:include ref="editor.repeated" />
    <xed:include ref="place" />
    <xed:include ref="publisher" />
    <xed:include ref="year.issued" />
    <xed:bind xpath="mods:relatedItem[@type='host']">
      <xed:include ref="host.volume" />
      <xed:include ref="host.issue" />
    </xed:bind>
    <xed:include ref="extent" />
    <xed:include ref="identifier.managed" />
    <xed:include ref="identifier.issn" />
    <xed:include ref="language" />
    <xed:include ref="sdnb.repeat" />
    <xed:include ref="subject.simple" />
    <xed:include ref="abstract.simple" />
    <xed:include ref="embargo.datetimepicker" />
    <xed:include ref="access" />
    <xed:include ref="rights" />
  </xed:template>

  <!-- ========== General: Overrides ========== -->
  <!-- institutes are required and repeatable -->
  <xed:template id="institutes">
    <mir:insitut.repeated min="1" max="10" label="mir.institution" help-text="{i18n:mir.help.institutes}" />
  </xed:template>

  <!-- adds help text -->
  <xed:template id="title.issue.relItemsearch">
    <mir:relItemsearch
      searchengine="title"
      genre="issue"
      responsefield="mods.title"
      xpath="mods:titleInfo/mods:title"
      label="mir.title.issue"
      help-text="{i18n:mir.help.title.issue}"
      class="required" />
  </xed:template>

</xed:template>
